{$MAIL_HOSTNAME} {
  encode zstd gzip

  @meovv path / /assets/* /favicon.svg /health/* /metrics /api/setup/* /api/session/* /api/mail/* /api/admin/* /api/internal/* /api/v1/*
  handle @meovv {
    reverse_proxy meovv:8080
  }

  @stalwart path /.well-known/* /jmap /jmap/* /auth/* /api/auth /api/discover/* /api/account /api/token/* /mail/config-v1.1.xml /autodiscover/*
  handle @stalwart {
    reverse_proxy https://stalwart:443 {
      transport http {
        tls_insecure_skip_verify
      }
    }
  }

  handle {
    reverse_proxy meovv:8080
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
}
